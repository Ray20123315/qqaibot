def replace_once(text, old, new, label):
    count = text.count(old)
    if count != 1:
        raise RuntimeError(f'{label}: expected 1 anchor, got {count}')
    return text.replace(old, new, 1)

def git_show(path):
    return subprocess.check_output(['git', 'show', f'{HIST}:{path}']).strip()

