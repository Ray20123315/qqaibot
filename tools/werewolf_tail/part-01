  var escW=function(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})};
  var state=null, roles={};
  var actionLabels={
    sheriff_nominate:'竞选警长',sheriff_vote:'警长投票',day_vote:'白天投票',
    wolf_kill:'狼人袭击',berserk_vote:'暴走狼双票',inspect:'预言查验',protect:'守卫守护',
    witch_heal:'女巫解药',witch_poison:'女巫毒药',decoy:'忍者替身',disguise:'百变狼伪装',
    blood_moon:'发动血月',couple:'邱比特配对',meat_shield:'教徒肉盾',redirect:'人鱼引导',
    copy_dead:'掘墓复制',track:'侦探追踪',visit:'夜访',swap_role:'盗贼换职',
    vigilance:'村民警戒',curse:'巫毒诅咒',hex:'蛊惑',death_shot:'死亡带走',
    duel:'骑士决斗',white_judgement:'白狼王审判',plant_bomb:'炸弹植入',
    group_inspect:'分组查验',wolf_chat:'狼人密谈'
  };
  var allActions=Object.keys(actionLabels);
  function notifyW(message){if(typeof toast==='function')toast(message);else alert(message)}
  async function callW(path,method,body){
    if(typeof api!=='function')return {ok:false,message:'Portal API 尚未初始化。'};
    return api(path,method||'GET',body);
  }
  function currentGroupReady(){
    try{return !!currentGroup}catch(_){return false}
  }
  function playerOptions(players,includeDead){
    return '<option value="">请选择</option>'+(players||[]).filter(function(p){return includeDead||p.alive}).map(function(p){return '<option value="'+escW(p.id)+'">'+escW(p.name)+'（'+escW(p.id)+'）'+(p.alive?'':'［已死亡］')+'</option>'}).join('');
  }
  function renderRoles(){
    var box=byId('wwRolePool');if(!box)return;
    box.innerHTML=Object.keys(roles||{}).map(function(id){
      var r=roles[id]||{};
      return '<label class="ww-role-option"><input type="checkbox" value="'+escW(id)+'"><span><b>'+escW(r.name||id)+'</b><small>'+escW(r.summary||'')+'</small></span></label>';
    }).join('')||'<div class="empty">尚未取得职业资料。</div>';
  }
  function renderLog(id,rows,secret){
    var box=byId(id);if(!box)return;
    box.innerHTML=(rows||[]).slice().reverse().map(function(row){
      var text=typeof row==='string'?row:(row.text||row.message||JSON.stringify(row));
      var at=Number(row&&row.at||0);
      return '<div class="ww-log-row">'+(at?'<small>'+escW(new Date(at).toLocaleString())+'</small><br>':'')+escW(text)+(secret&&row&&row.type?'<br><small>'+escW(row.type)+'</small>':'')+'</div>';
    }).join('')||'<div class="empty">暂无记录。</div>';
  }
  function renderGame(game){
    state=game||null;
    var status=byId('wwStatus');
    if(!game){
      if(status)status.textContent='当前群没有狼人杀房间。';
      ['wwPlayers','wwPublicLog','wwPrivateLog','wwWolfChatLog'].forEach(function(id){var e=byId(id);if(e)e.innerHTML='<div class="empty">暂无资料。</div>'});
      if(byId('wwOwn'))byId('wwOwn').textContent='加入并开始后显示。';
      return;
    }
    if(status)status.textContent='房间 '+game.id+'｜'+game.status+'｜'+game.phaseLabel+(game.phaseEndsAt?'｜阶段截止 '+new Date(game.phaseEndsAt).toLocaleTimeString():'');
    if(byId('wwPhaseText'))byId('wwPhaseText').textContent='第 '+Number(game.day||0)+' 天／第 '+Number(game.night||0)+' 夜｜'+game.phaseLabel+(game.winner?'｜胜利：'+JSON.stringify(game.winner):'');
    var players=game.players||[];
    if(byId('wwPlayers'))byId('wwPlayers').innerHTML=players.map(function(p){
      return '<div class="item ww-player '+(p.alive?'':'dead')+'"><div><b>'+escW(p.name)+'</b><div class="item-meta">'+escW(p.id)+(p.isAi?'｜AI':'')+(p.isSheriff?'｜警长':'')+'</div></div><span class="ww-badge">'+(p.alive?'存活':'死亡')+(p.roleName?'｜'+escW(p.roleName):'')+'</span></div>';
    }).join('')||'<div class="empty">尚无玩家。</div>';
    renderLog('wwPublicLog',game.publicLog||[],false);
    var own=game.own;
    if(byId('wwOwn'))byId('wwOwn').innerHTML=own?'<b>'+escW(own.roleName)+'</b>｜阵营 '+escW(own.team)+'｜'+escW(own.summary)+'<br><small>分组：'+escW(own.groupTeam||0)+'｜可见狼队：'+escW((own.visibleWolfIds||[]).join('、')||'无')+'</small>':'你不是本局玩家，或游戏尚未开始。';
    renderLog('wwPrivateLog',own&&own.privateNotices||[],true);
    renderLog('wwWolfChatLog',own&&own.wolfChat||[],true);
    var targetHtml=playerOptions(players,false), allHtml=playerOptions(players,true);
    if(byId('wwTarget'))byId('wwTarget').innerHTML=targetHtml;
    if(byId('wwSecondTarget'))byId('wwSecondTarget').innerHTML=targetHtml;
    var actionSelect=byId('wwAction');
    if(actionSelect)actionSelect.innerHTML=allActions.map(function(a){return '<option value="'+escW(a)+'">'+escW(actionLabels[a])+'</option>'}).join('');
    var canManage=!!game.canManage;
    ['wwStart','wwAdvance','wwAbort'].forEach(function(id){var b=byId(id);if(b)b.disabled=!canManage});
    if(byId('wwCreatePanel'))byId('wwCreatePanel').classList.toggle('hidden',!['ended','aborted'].includes(game.status)&&game.status!=='');
  }
  async function loadW(){
    var status=byId('wwStatus');
    if(!currentGroupReady()){if(status)status.textContent='请先选择群组。';return}
    if(status)status.textContent='正在读取狼人杀资料…';
    var r=await callW('/werewolf/state','GET');
    if(!r||!r.ok){if(status)status.textContent=(r&&r.message)||'读取失败。';return}
    roles=r.roles||roles;renderRoles();renderGame(r.game||null);
  }
  async function postW(path,body){
    var r=await callW(path,'POST',body||{});
    notifyW((r&&r.message)||'操作完成');
    if(r&&r.game)renderGame(r.game);else if(r&&r.ok)await loadW();
    return r;
  }
  function checkedRoles(){
    return Array.from(document.querySelectorAll('#wwRolePool input[type=checkbox]:checked')).map(function(x){return x.value});
  }
  function bind(id,fn){var e=byId(id);if(e)e.onclick=fn}
  bind('wwRefresh',loadW);
  bind('wwCreate',function(){postW('/werewolf/create',{config:{maxPlayers:Number(byId('wwMaxPlayers').value||12),aiCount:Number(byId('wwAiCount').value||0),groupCount:Number(byId('wwGroupCount').value||0),sheriffEnabled:!!byId('wwSheriff').checked,selectedRoles:checkedRoles()}})});
  bind('wwJoin',function(){postW('/werewolf/join',{})});
  bind('wwLeave',function(){postW('/werewolf/leave',{})});
  bind('wwStart',function(){postW('/werewolf/start',{})});
  bind('wwAdvance',function(){postW('/werewolf/advance',{})});
